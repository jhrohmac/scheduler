<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<!-- System Log -->
	<bean id="systemLogController" class="com.scheduler.system.controller.SystemLogController">										  
		<property name="systemLogDao" ref="systemLogDaoImpl"></property>
	</bean>
	<bean id="systemLogDaoImpl" class="com.scheduler.system.dao.impl.SystemLogDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- Process Manage -->
	<bean id="processManagementController" class="com.scheduler.system.controller.ProcessManagementController">										  
		<property name="processManagementDao" ref="processManagementDaoImpl"></property>
	</bean>
	<bean id="processManagementDaoImpl" class="com.scheduler.system.dao.impl.ProcessManagementDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- System Config -->
	<bean id="systemConfigController" class="com.scheduler.system.controller.SystemConfigController">										  
		<property name="systemConfigDao" ref="systemConfigDaoImpl"></property>
	</bean>
	<bean id="systemConfigDaoImpl" class="com.scheduler.system.dao.impl.SystemConfigDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- System Account-->
	<bean id="systemAccountController" class="com.scheduler.system.controller.SystemAccountController">										  
		<property name="systemAccountDao" ref="systemAccountDaoImpl"></property>
	</bean>
	<bean id="systemAccountDaoImpl" class="com.scheduler.system.dao.impl.SystemAccountDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- MarkitWire Account-->
	<bean id="markitWireAccountController" class="com.scheduler.system.controller.MarkitWireAccountController">										  
		<property name="markitWireAccountDao" ref="markitWireAccountDaoImpl"></property>
	</bean>
	<bean id="markitWireAccountDaoImpl" class="com.scheduler.system.dao.impl.MarkitWireAccountDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
</beans>