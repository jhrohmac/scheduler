<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
       
<!-- ======================================================= -->
    <!-- Index 자동 재빌드 (ORA-01502 자동 복구)              -->
    <!-- ======================================================= -->
    <bean id="indexMaintenanceService"
          class="com.scheduler.comm.system.IndexMaintenanceService">
        <property name="dataSource" ref="dataSource"/>
    </bean>

<!-- IPS Source -->
    <!-- Login -->
    <bean id="loginController" class="com.scheduler.login.controller.LoginController">                                      
		<property name="loginDao" ref="loginDaoImpl"></property>
	</bean>
	
	<bean id="loginDaoImpl" class="com.scheduler.login.dao.impl.LoginDaoImpl">	                               
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>	
	
	<!--Side Menu -->
	<bean id="menuController" class="com.scheduler.comm.controller.MenuController">
		<property name="menuDao" ref="menuDaoImpl"></property>
	</bean>
	<bean id="menuDaoImpl" class="com.scheduler.comm.dao.impl.MenuDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- Common Item -->	
    <bean id="itemCodeController" class="com.scheduler.comm.controller.ItemCodeController">
		<property name="itemCodeDao" ref="itemCodeDaoImpl"></property>
	</bean>
	<bean id="itemCodeDaoImpl" class="com.scheduler.comm.dao.impl.ItemCodeDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- UserSetting Info -->
	<bean id="userSettingController" class="com.scheduler.comm.controller.UserSettingController">
		<property name="userSettingDao" ref="userSettingDaoImpl"></property>
	</bean>
	<bean id="userSettingDaoImpl" class="com.scheduler.comm.dao.impl.UserSettingDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
	<!-- UserManage Info -->
	<bean id="userManageController" class="com.scheduler.management.controller.UserManageController">
		<property name="userManagementDao" ref="userManageDaoImpl"></property>
	</bean>	
	<bean id="userManageDaoImpl" class="com.scheduler.management.dao.impl.UserManageDaoImpl">
		<property name="sqlSessionTemplate" ref="sqlSessionTemplate"></property>
	</bean>
	
</beans>