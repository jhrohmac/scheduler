<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.scheduler.stock.sql.StkMaster">

    <select id="selectStkMasterList" parameterType="hashmap" resultType="recSignalDto">
        SELECT STK_CD AS stkCd,
               STK_NM AS stkNm,
               MKT_CD AS mktCd
          FROM TB_STK_MASTER
         WHERE USE_YN = 'Y'
           AND STK_STATUS = 'NORMAL'
         ORDER BY STK_CD ASC
    </select>

</mapper>
