<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration PUBLIC "-//LOGGER" "./log4j.dtd"> 
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/"> 	
  
	<!-- Appenders -->    
	<appender name="console" class="org.apache.log4j.ConsoleAppender">
		<param name="threshold" value="ALL" />
<!-- 		<param name="threshold" value="ERROR" /> -->
		<layout class="org.apache.log4j.PatternLayout">
			<!-- <param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm}] %5p [%C{1}(%M:%L)] :%m%n%n" /> -->
			<param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm}] %5p [%C(%M:%L)] :%m%n%n" />
		</layout>
		<filter class="org.apache.log4j.varia.StringMatchFilter">
      		<param name="StringToMatch" value="Result" />	<!-- Merge 쿼리 console 창에 나오지 않도록 필터에 추가 -->
      		<param name="AcceptOnMatch" value="false" />
    	</filter>
    	<!-- <filter class="org.apache.log4j.varia.DenyAllFilter" /> -->
	</appender>	
	
	<!--Definition of the File Appender -->
	<appender name="file" class="org.apache.log4j.RollingFileAppender">
        <param name="File" value="${catalina.base}/logs/scheduler/scheduler.log"/>
    	<param name="Append" value="true"/>
    	<param name="MaxFileSize" value="10MB"/>
    	<param name="MaxBackupIndex" value="2"/>
    	<param name="threshold" value="ERROR"/>	<!-- Default log level -->
    	<layout class="org.apache.log4j.PatternLayout">
    		<param name="ConversionPattern" value="%d{yy-MM-dd HH:mm:ss.SSS} %5p %C [%M :%L] %m%n" />
    	</layout>
    </appender>
    
    <!-- 3rdparty Loggers -->   
    <logger name="org.springframework">
    	<level value="error"/>
    	<appender-ref ref="console"/>
  	</logger>
  	
  	<logger name="org.springframework.jdbc">
    	<level value="warn"/>
    	<appender-ref ref="console" />
  	</logger>
  	
  	<!-- log SQL with timing information, post execution -->
	<logger name="jdbc.sqltiming" additivity="false">
		<level value="info" />
		<appender-ref ref="file" />
	</logger>
	
  	 <!-- Filtering logs from specific class -->
    
	<logger name="org.apache.ibatis">
    	<level value="DEBUG"/>
    	<appender-ref ref="console" />
  	</logger>

	<!-- log SQL (pre-execution) plus exceptions caused by SQL -->
<!--   	<logger name="jdbc.sqlonly" additivity="false">
		<level value="warn" />
		<appender-ref ref="console" />
	</logger> -->

	<!-- log all jdbc calls except ResultSet calls -->
 	<logger name="jdbc.audit" additivity="false">
		<level value="DEBUG" />
		<appender-ref ref="console" />
 	</logger>
	
	<!-- log the jdbc ResultSet calls -->
 	<logger name="jdbc.resultset" additivity="false">
		<level value="DEBUG" />
		<appender-ref ref="console" />
 	</logger>
	
	<logger name="log4jdbc.debug" additivity="false">
		<level value="DEBUG" />		
		<appender-ref ref="console" />		
		<appender-ref ref="file"/>	
	</logger>
	
	<root>
		<level value="DEBUG" />		
		<appender-ref ref="console" />
		<appender-ref ref="file"/>
	</root> 
</log4j:configuration>
